{
  "name": "super-app-platform",
  "version": "1.0.0",
  "description": "Integrated Logistics & Mobility Platform - Microservices Architecture",
  "private": true,
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "dev:all": "concurrently npm:dev:*",
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:parcel": "cd services/parcel-service && npm run dev",
    "dev:ride": "cd services/ride-service && npm run dev",
    "dev:ticket": "cd services/ticket-service && npm run dev",
    "dev:payment": "cd services/payment-service && npm run dev",
    "dev:notification": "cd services/notification-service && npm run dev",
    "test:all": "jest --coverage",
    "lint:all": "eslint 'services/**/*.ts' 'shared/**/*.ts'",
    "format:all": "prettier --write 'services/**/*.ts' 'shared/**/*.ts'",
    "db:migrate": "cd services && for dir in */; do cd \"$dir\" && npm run db:migrate && cd ..; done",
    "db:seed": "cd services && for dir in */; do cd \"$dir\" && npm run db:seed && cd ..; done",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "k8s:deploy": "cd infrastructure/kubernetes && kubectl apply -f .",
    "k8s:delete": "cd infrastructure/kubernetes && kubectl delete -f .",
    "tf:init": "cd infrastructure/terraform && terraform init",
    "tf:plan": "cd infrastructure/terraform && terraform plan",
    "tf:apply": "cd infrastructure/terraform && terraform apply",
    "tf:destroy": "cd infrastructure/terraform && terraform destroy"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
